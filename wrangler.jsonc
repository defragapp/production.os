{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "production-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "production-os-db",
      "database_id": "f4274cce-4444-4501-85a9-58c28bff27ac"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "8ccb87e3a5554f849d69053df7275a29"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_GATEWAY_ID": "sovereign-ai-gateway",
    "FROM_EMAIL": "info@sovereign.os",
    "BASELINE_HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "STRIPE_PRICE_SOVEREIGN_PLUS_MONTHLY": "price_1Te0g9Bk78yJ8Hww8fFZCqhm",
    "STRIPE_PRICE_SOVEREIGN_PLUS_ANNUAL": "price_1Tq6nPBk78yJ8Hwwm0pxg4hH",
    "STRIPE_SUCCESS_URL": "https://app.defrag.app/chat?billing=success",
    "STRIPE_CANCEL_URL": "https://app.defrag.app/chat?billing=cancelled"
  }
}
