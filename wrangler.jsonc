{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "production-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // head_sampling_rate 1.0 for the launch window; revert to 0.1 at T+10d.
  // Full-trace logs during launch week are the whole point of a paid
  // Workers Logs plan — this is what makes the 1102 / JPL 429 diagnosis
  // possible the moment traffic appears.
  "observability": { "enabled": true, "head_sampling_rate": 1.0 },
  "d1_databases": [
    { "binding": "DB", "database_name": "production-os-db", "database_id": "f4274cce-4444-4501-85a9-58c28bff27ac" }
  ],
  "kv_namespaces": [
    { "binding": "SESSION_KV", "id": "8ccb87e3a5554f849d69053df7275a29" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "sovereign-ai-gateway",
    "FROM_EMAIL": "sovereign@defrag.app",
    "SUPPORT_INBOX": "chadowen93@gmail.com",
    "BASELINE_HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "STRIPE_PRICE_SOVEREIGN_PLUS_MONTHLY": "price_1Te0g9Bk78yJ8Hww8fFZCqhm",
    "STRIPE_PRICE_SOVEREIGN_PLUS_ANNUAL": "price_1Tq6nPBk78yJ8Hwwm0pxg4hH",
    "STRIPE_SUCCESS_URL": "https://sovereign.defrag.app/chat?billing=success",
    "STRIPE_CANCEL_URL": "https://sovereign.defrag.app/upgrade?billing=cancelled",
    "STRIPE_PORTAL_RETURN_URL": "https://sovereign.defrag.app/account",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAExjLzsh-Wwl9x4Y",
    "NEXT_PUBLIC_CF_BEACON_TOKEN": "8b2341038462480c95e05d8e11f07213",
    "TURNSTILE_REQUIRED": "true"
  }
}
