{
  "name": "production-os",
  "version": "0.1.0",
  "private": true,
  "//release": "CANONICAL RELEASE PATH, in this order: (1) `npm run verify:release` — every gate in scripts/verify-release.mjs green (the count grows with each ratchet; the script's own header is the source of truth), (2) `git push origin main`, (3) `npx wrangler deployments list` a couple of minutes later to confirm the new version rolled out. Step 3 is a CHECK, not a deploy: Workers Builds on the git integration fires on every push to main (each recent push produced a build-system-authored version alongside the CLI-authored one), so pushing DOES ship. Running `rm -rf .open-next .next && npm run deploy` straight after a push is a second build of the same commit in flight, and colliding builds stall static-asset binding propagation (the 503/hang seen on /, /privacy, /terms). Deploy from the CLI only when the listing shows no new version ~3 minutes after the push, or when the tree to ship is not yet on main.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env cloudflare",
    "db:migrate": "wrangler d1 execute production-os-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute production-os-db --remote --file=./schema.sql",
    "db:migrate:0001": "wrangler d1 execute production-os-db --local --file=./migrations/0001_token_version.sql",
    "db:migrate:0001:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0001_token_version.sql",
    "db:migrate:0002": "wrangler d1 execute production-os-db --local --file=./migrations/0002_chat_usage.sql",
    "db:migrate:0002:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0002_chat_usage.sql",
    "db:migrate:0003": "wrangler d1 execute production-os-db --local --file=./migrations/0003_journeys.sql",
    "db:migrate:0003:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0003_journeys.sql",
    "db:migrate:0004": "wrangler d1 execute production-os-db --local --file=./migrations/0004_compliance_and_owner.sql",
    "db:migrate:0004:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0004_compliance_and_owner.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
