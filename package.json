{
  "name": "production-os",
  "version": "0.1.0",
  "private": true,
  "//release": "CANONICAL RELEASE PATH, in this order: (1) `npm run verify:release` — every gate in scripts/verify-release.mjs green (the count grows with each ratchet; the script's own header is the source of truth), (2) `git push origin main`, (3) `npx wrangler deployments list` POLLED for ~2 minutes to see whether a new version rolled out. Workers Builds on the git integration is SUPPOSED to fire on every push to main, but it is NOT dependable on its own — on release 11586ad no build-system-authored version had landed ~6 minutes after the push, so the release had to be shipped by hand. Treat step 3 as a CHECK of the push, not an assumption: if no new version appears within ~2 minutes, run `rm -rf .open-next .next && npm run deploy` exactly once. A CLI-authored version shows your email as Author; a build-system version shows undefined. NEVER run the CLI deploy while a push-triggered build is still in flight — that is a second build of the same commit at once, and colliding builds stall static-asset binding propagation (the 503/hang seen on /, /privacy, /terms).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env cloudflare",
    "db:migrate": "wrangler d1 execute production-os-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute production-os-db --remote --file=./schema.sql",
    "db:migrate:0001": "wrangler d1 execute production-os-db --local --file=./migrations/0001_token_version.sql",
    "db:migrate:0001:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0001_token_version.sql",
    "db:migrate:0002": "wrangler d1 execute production-os-db --local --file=./migrations/0002_chat_usage.sql",
    "db:migrate:0002:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0002_chat_usage.sql",
    "db:migrate:0003": "wrangler d1 execute production-os-db --local --file=./migrations/0003_journeys.sql",
    "db:migrate:0003:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0003_journeys.sql",
    "db:migrate:0004": "wrangler d1 execute production-os-db --local --file=./migrations/0004_compliance_and_owner.sql",
    "db:migrate:0004:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0004_compliance_and_owner.sql",
    "db:migrate:0005": "wrangler d1 execute production-os-db --local --file=./migrations/0005_threads_user_updated_index.sql",
    "db:migrate:0005:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0005_threads_user_updated_index.sql",
    "db:migrate:0006": "wrangler d1 execute production-os-db --local --file=./migrations/0006_relationship_history.sql",
    "db:migrate:0006:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0006_relationship_history.sql",
    "db:migrate:0007": "wrangler d1 execute production-os-db --local --file=./migrations/0007_nudge.sql",
    "db:migrate:0007:remote": "wrangler d1 execute production-os-db --remote --file=./migrations/0007_nudge.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:edge": "node scripts/verify-edge-cache.mjs",
    "tail:deploy": "wrangler deploy --config tail-worker/wrangler.jsonc",
    "tail:secret:resend": "wrangler secret put RESEND_API_KEY --config tail-worker/wrangler.jsonc",
    "tail:dev": "wrangler dev --config tail-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
